#!/bin/sh
# Runs once per push, not per commit, so it stays out of the way.
#
# This exact trio would have stopped a broken app.js from ever reaching the
# branch: nothing in Python imports that file, so a syntax error in it is
# invisible to the whole test suite and total in the browser.
#
# Bypass deliberately with: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

printf 'pre-push  ruff ......... '
uv run ruff check . >/dev/null && echo ok

printf 'pre-push  app.js ....... '
if command -v node >/dev/null 2>&1; then
  node --check src/lykkepoller/static/app.js && echo ok
else
  echo "skipped (no node)"
fi

printf 'pre-push  pytest ....... '
uv run pytest -q >/dev/null && echo ok
